{
  "name": "cf-crawl",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26"
  },
  "version": "4.1.0",
  "description": "Crawl and scrape websites using the Cloudflare Browser Rendering API",
  "license": "MIT",
  "keywords": [
    "cloudflare",
    "browser-rendering",
    "web-scraping",
    "crawler",
    "cli",
    "markdown",
    "pdf",
    "screenshot",
    "typescript",
    "claude-code-skill"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/bart-turczynski/cf-crawl.git"
  },
  "homepage": "https://gitlab.com/bart-turczynski/cf-crawl",
  "bugs": {
    "url": "https://gitlab.com/bart-turczynski/cf-crawl/-/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cf-crawl": "dist/index.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "skill"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "pnpm run build",
    "dev": "tsx index.ts",
    "crawl": "tsx index.ts crawl",
    "crawl:render": "tsx index.ts crawl --render",
    "scrape": "tsx index.ts scrape",
    "markdown": "tsx index.ts markdown",
    "content": "tsx index.ts content",
    "links": "tsx index.ts links",
    "json": "tsx index.ts json",
    "pdf": "tsx index.ts pdf",
    "screenshot": "tsx index.ts screenshot",
    "snapshot": "tsx index.ts snapshot",
    "tomarkdown": "tsx index.ts tomarkdown",
    "export": "tsx index.ts export",
    "status": "tsx index.ts status",
    "download": "tsx index.ts download",
    "jobs": "tsx index.ts jobs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "citation:check": "python3 scripts/check-citation-nonr.py --source package-json"
  },
  "dependencies": {
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^25.9.9",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  }
}
